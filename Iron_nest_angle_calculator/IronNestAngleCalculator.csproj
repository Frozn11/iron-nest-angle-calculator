<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>CalculateAngleViaDistanceIronNest</RootNamespace>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<ApplicationIcon>Iron-Nest-icon.ico</ApplicationIcon>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<AssemblyName>IronNestCalc-win-x64</AssemblyName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
		<AssemblyName>IronNestCalc-win-x86</AssemblyName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<AssemblyName>IronNestCalc-linux-x64</AssemblyName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
		<AssemblyName>IronNestCalc-osx-x64</AssemblyName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
		<AssemblyName>IronNestCalc-osx-arm64</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Spectre.Console" Version="0.57.2" />
	</ItemGroup>

</Project>